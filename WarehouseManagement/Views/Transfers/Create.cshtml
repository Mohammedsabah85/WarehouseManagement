@model WarehouseManagement.Models.Transfer

@{
    ViewData["Title"] = "إنشاء عملية نقل";
}

<h2>إنشاء عملية نقل جديدة</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="MaterialId" class="control-label"></label>
                        <select asp-for="MaterialId" class="form-control" asp-items="ViewBag.MaterialId" id="materialSelect">
                            <option value="">-- اختر المادة --</option>
                        </select>
                        <span asp-validation-for="MaterialId" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Quantity" class="control-label"></label>
                        <input asp-for="Quantity" class="form-control" min="1" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="FromLocationId" class="control-label"></label>
                        <select asp-for="FromLocationId" class="form-control" asp-items="ViewBag.FromLocationId">
                            <option value="">-- اختر الموقع المصدر --</option>
                        </select>
                        <span asp-validation-for="FromLocationId" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="ToLocationId" class="control-label"></label>
                        <select asp-for="ToLocationId" class="form-control" asp-items="ViewBag.ToLocationId">
                            <option value="">-- اختر الموقع المقصد --</option>
                        </select>
                        <span asp-validation-for="ToLocationId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="TransferredBy" class="control-label"></label>
                        <input asp-for="TransferredBy" class="form-control" />
                        <span asp-validation-for="TransferredBy" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Reason" class="control-label"></label>
                        <input asp-for="Reason" class="form-control" />
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="إنشاء" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // تحديث قائمة المواد بناءً على الموقع المختار
        document.getElementById('FromLocationId').addEventListener('change', function() {
            var locationId = this.value;
            var materialSelect = document.getElementById('materialSelect');

            // مسح الخيارات الحالية
            materialSelect.innerHTML = '<option value="">-- اختر المادة --</option>';

            if (locationId) {
                // يمكن إضافة AJAX هنا لجلب المواد المتاحة في الموقع المحدد
                fetch(`/api/materials/bylocation/${locationId}`)
                    .then(response => response.json())
                    .then(materials => {
                        materials.forEach(material => {
                            var option = document.createElement('option');
                            option.value = material.id;
                            option.text = `${material.name} (${material.quantity} ${material.unit})`;
                            materialSelect.appendChild(option);
                        });
                    })
                    .catch(error => console.log('Error:', error));
            }
        });
    </script>
}