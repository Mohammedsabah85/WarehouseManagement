@model WarehouseManagement.Models.PurchaseBatch
@{
    ViewData["Title"] = "حذف دفعة الشراء";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>تأكيد الحذف
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        هل أنت متأكد من حذف دفعة الشراء التالية؟
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">اسم المادة</dt>
                        <dd class="col-sm-8">@Model.MaterialName</dd>

                        <dt class="col-sm-4">الرقم الرمزي</dt>
                        <dd class="col-sm-8"><code>@Model.CodeNumber</code></dd>

                        <dt class="col-sm-4">سنة الشراء</dt>
                        <dd class="col-sm-8">@Model.PurchaseYear</dd>

                        <dt class="col-sm-4">العدد/الكمية</dt>
                        <dd class="col-sm-8">@Model.Quantity</dd>

                        <dt class="col-sm-4">سعر المفرد</dt>
                        <dd class="col-sm-8">@Model.UnitPrice.ToString("N0") د.ع</dd>

                        <dt class="col-sm-4">السعر الكلي</dt>
                        <dd class="col-sm-8">
                            <strong class="text-danger">@Model.TotalPrice.ToString("N0") د.ع</strong>
                        </dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" asp-route-form2ItemId="@Model.Form2ItemId" class="btn btn-secondary">
                                <i class="bi bi-arrow-right me-1"></i>إلغاء
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>تأكيد الحذف
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
