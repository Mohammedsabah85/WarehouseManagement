@model WarehouseManagement.Models.ViewModels.Form2ViewModel

@{
    ViewData["Title"] = $"نموذج رقم (2) - سنة {Model.Year}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-clipboard-list"></i> نموذج رقم (2)</h2>
        <p class="text-muted mb-0">قائمة الموجودات الرئيسية - سنة @Model.Year</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> إضافة عنصر جديد
        </a>
        <a asp-action="Report" asp-route-year="@Model.Year" asp-route-department="@Model.Department" 
           class="btn btn-success">
            <i class="fas fa-file-alt"></i> عرض التقرير
        </a>
        <a asp-action="PrintReport" asp-route-year="@Model.Year" asp-route-department="@Model.Department" 
           class="btn btn-info" target="_blank">
            <i class="fas fa-print"></i> طباعة
        </a>
    </div>
</div>

<!-- فلاتر البحث -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-2">
                <label class="form-label">السنة</label>
                <select name="year" class="form-select" onchange="this.form.submit()">
                    @foreach (var y in (List<int>)ViewBag.Years)
                    {
                        <option value="@y" selected="@(y == Model.Year)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">القسم</label>
                <select name="department" class="form-select">
                    <option value="">-- الكل --</option>
                    @foreach (var dept in (List<string?>)ViewBag.Departments)
                    {
                        <option value="@dept" selected="@(dept == Model.Department)">@dept</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">البحث</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" 
                       class="form-control" placeholder="اسم المادة أو رقم الترميز...">
            </div>
            <div class="col-md-2">
                <label class="form-label">الحالة</label>
                <select name="conditionFilter" class="form-select">
                    <option value="">-- الكل --</option>
                    @foreach (var cond in (List<string>)ViewBag.Conditions)
                    {
                        <option value="@cond" selected="@(cond == Model.ConditionFilter)">@cond</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">العائدية</label>
                <select name="ownershipFilter" class="form-select">
                    <option value="">-- الكل --</option>
                    @foreach (var own in (List<string?>)ViewBag.Ownerships)
                    {
                        <option value="@own" selected="@(own == Model.OwnershipFilter)">@own</option>
                    }
                </select>
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- إحصائيات -->
<div class="row mb-4">
    <div class="col-md-2">
        <div class="card bg-primary text-white">
            <div class="card-body text-center py-3">
                <h4 class="mb-0">@Model.Statistics.TotalItems</h4>
                <small>إجمالي العناصر</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-success text-white">
            <div class="card-body text-center py-3">
                <h4 class="mb-0">@Model.Statistics.TotalQuantityByInventory</h4>
                <small>الكمية بالجرد</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-info text-white">
            <div class="card-body text-center py-3">
                <h4 class="mb-0">@Model.Statistics.TotalQuantityByRecords</h4>
                <small>الكمية بالسجلات</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card @(Model.Statistics.TotalDifference == 0 ? "bg-success" : Model.Statistics.TotalDifference > 0 ? "bg-warning" : "bg-danger") text-white">
            <div class="card-body text-center py-3">
                <h4 class="mb-0">@Model.Statistics.TotalDifference</h4>
                <small>الفرق</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-secondary text-white">
            <div class="card-body text-center py-3">
                <h4 class="mb-0">@Model.Statistics.TotalCost.ToString("N0")</h4>
                <small>الكلفة (دينار)</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-dark text-white">
            <div class="card-body text-center py-3">
                <h4 class="mb-0">@Model.Statistics.ItemsInForm5</h4>
                <small>في نموذج (5)</small>
            </div>
        </div>
    </div>
</div>

<!-- جدول البيانات -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center" style="width: 40px;">ت</th>
                        <th>اسم المادة</th>
                        <th>الوصف</th>
                        <th class="text-center">رقم الترميز</th>
                        <th class="text-center">بموجب الجرد</th>
                        <th class="text-center">بموجب السجلات</th>
                        <th class="text-center">الفرق</th>
                        <th>محل التواجد</th>
                        <th class="text-end">الكلفة (دينار)</th>
                        <th class="text-center">الحالة</th>
                        <th>العائدية</th>
                        <th>الملاحظات</th>
                        <th class="text-center no-print" style="width: 120px;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="@(item.IsDocumentedInForm5 ? "table-warning" : "")">
                            <td class="text-center">@item.SequenceNumber</td>
                            <td>
                                @item.MaterialName
                                @if (item.IsDocumentedInForm5)
                                {
                                    <span class="badge bg-warning text-dark ms-1" title="تم التثبيت في نموذج 5">
                                        <i class="fas fa-exclamation-triangle"></i>
                                    </span>
                                }
                            </td>
                            <td>@(item.MaterialDescription ?? "-")</td>
                            <td class="text-center"><code>@item.CodeNumber</code></td>
                            <td class="text-center">@item.QuantityByInventory</td>
                            <td class="text-center">@item.QuantityByRecords</td>
                            <td class="text-center @(item.QuantityDifference == 0 ? "" : item.QuantityDifference > 0 ? "text-success" : "text-danger")">
                                @if (item.QuantityDifference == 0)
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <strong>@item.QuantityDifference</strong>
                                }
                            </td>
                            <td>@(item.LocationPlace ?? "القسم")</td>
                            <td class="text-end">@item.CostInDinar.ToString("N0")</td>
                            <td class="text-center">
                                <span class="badge @(item.Condition == "جيدة" || item.Condition == "جيد" ? "bg-success" : item.Condition == "متوسطة" ? "bg-warning" : "bg-danger")">
                                    @item.Condition
                                </span>
                            </td>
                            <td>@(item.Ownership ?? "-")</td>
                            <td>
                                <small>@(item.Notes ?? "-")</small>
                            </td>
                            <td class="text-center no-print">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Id" 
                                       class="btn btn-outline-info" title="عرض">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" 
                                       class="btn btn-outline-primary" title="تعديل">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @if (!item.IsDocumentedInForm5)
                                    {
                                        <a asp-action="TransferToForm5" asp-route-id="@item.Id" 
                                           class="btn btn-outline-warning" title="نقل لنموذج 5">
                                            <i class="fas fa-arrow-right"></i>
                                        </a>
                                    }
                                    <a asp-action="Delete" asp-route-id="@item.Id" 
                                       class="btn btn-outline-danger" title="حذف">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-secondary">
                    <tr>
                        <th colspan="4" class="text-end">المجموع:</th>
                        <th class="text-center">@Model.Statistics.TotalQuantityByInventory</th>
                        <th class="text-center">@Model.Statistics.TotalQuantityByRecords</th>
                        <th class="text-center">@Model.Statistics.TotalDifference</th>
                        <th></th>
                        <th class="text-end">@Model.Statistics.TotalCost.ToString("N0")</th>
                        <th colspan="4"></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-info mt-4">
        <h5><i class="fas fa-info-circle"></i> لا توجد بيانات</h5>
        <p>لا توجد عناصر مسجلة لسنة @Model.Year. يمكنك إضافة عناصر جديدة من خلال الزر أعلاه.</p>
    </div>
}

@section Scripts {
    <script>
        // تأكيد الحذف
        document.querySelectorAll('a[title="حذف"]').forEach(function(link) {
            link.addEventListener('click', function(e) {
                if (!confirm('هل أنت متأكد من حذف هذا العنصر؟')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
