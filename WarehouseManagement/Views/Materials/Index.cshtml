@model IEnumerable<WarehouseManagement.Models.Material>

@{
    ViewData["Title"] = "المواد";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>إدارة المواد</h2>
    <div>
        <a asp-action="Create" class="btn btn-primary">إضافة مادة جديدة</a>
        <a asp-action="Search" class="btn btn-outline-secondary">البحث المتقدم</a>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">إحصائيات سريعة</h5>
                <div class="row">
                    <div class="col-md-3">
                        <div class="text-center">
                            <h4 class="text-primary">@Model.Count()</h4>
                            <small>إجمالي المواد</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h4 class="text-success">@Model.Sum(m => m.Quantity)</h4>
                            <small>إجمالي الكمية</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h4 class="text-warning">@Model.Count(m => m.Quantity <= 10)</h4>
                            <small>مواد قليلة المخزون</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h4 class="text-danger">@Model.Count(m => m.ExpiryDate.HasValue && m.ExpiryDate <= DateTime.Now.AddDays(30))</h4>
                            <small>تنتهي خلال 30 يوم</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>الرمز</th>
                        <th>اسم المادة</th>
                        <th>الفئة</th>
                        <th>الموقع</th>
                        <th>الكمية</th>
                        <th>الوحدة</th>
                        <th>تاريخ انتهاء الصلاحية</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.Quantity <= 10 ? "table-warning" : "") @(item.ExpiryDate.HasValue && item.ExpiryDate <= DateTime.Now.AddDays(30) ? "table-danger" : "")">
                            <td>@Html.DisplayFor(modelItem => item.Code)</td>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Category.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Location.Name)</td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Quantity)
                                @if (item.Quantity <= 10)
                                {
                                    <span class="badge bg-warning">قليل</span>
                                }
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Unit)</td>
                            <td>
                                @if (item.ExpiryDate.HasValue)
                                {
                                    @item.ExpiryDate.Value.ToString("yyyy-MM-dd")
                                    @if (item.ExpiryDate <= DateTime.Now.AddDays(30))
                                    {
                                        <span class="badge bg-danger">قريب الانتهاء</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">غير محدد</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">عرض</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
