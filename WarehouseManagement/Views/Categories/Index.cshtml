@model IEnumerable<WarehouseManagement.Models.Category>

@{
    ViewData["Title"] = "إدارة الفئات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>إدارة فئات المواد</h2>
    <a asp-action="Create" class="btn btn-primary">إضافة فئة جديدة</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>اسم الفئة</th>
                        <th>الوصف</th>
                        <th>عدد المواد</th>
                        <th>تاريخ الإنشاء</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@(item.Description ?? "غير محدد")</td>
                            <td>
                                <span class="badge bg-info">@item.Materials.Count</span>
                            </td>
                            <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">عرض</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>