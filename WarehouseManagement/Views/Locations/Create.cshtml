@using WarehouseManagement.Extensions
@model WarehouseManagement.Models.Location

@{
    ViewData["Title"] = "إضافة موقع جديد";
}

<h2>إضافة موقع جديد</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Code" class="control-label"></label>
                        <input asp-for="Code" class="form-control" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                        <small class="form-text text-muted">رمز فريد للموقع (مثل: WH-01)</small>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Type" class="control-label"></label>
                        <select asp-for="Type" class="form-control">
                            @foreach (var type in Enum.GetValues<WarehouseManagement.Models.LocationType>())
                            {
                                <option value="@type">@type.GetDisplayName()</option>
                            }
                        </select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Building" class="control-label"></label>
                        <input asp-for="Building" class="form-control" />
                        <span asp-validation-for="Building" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Floor" class="control-label"></label>
                        <input asp-for="Floor" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Floor" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="MaxCapacity" class="control-label"></label>
                        <input asp-for="MaxCapacity" class="form-control" type="number" min="1" />
                        <span asp-validation-for="MaxCapacity" class="text-danger"></span>
                        <small class="form-text text-muted">السعة القصوى للموقع (اختياري)</small>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="إضافة" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}