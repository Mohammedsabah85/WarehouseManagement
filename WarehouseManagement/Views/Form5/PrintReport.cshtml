@using WarehouseManagement.Extensions
@model WarehouseManagement.Models.ViewModels.Form5ReportViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>نموذج رقم (5) - قائمة الموجودات المستهلكة</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <style>
        body {
            font-family: 'Traditional Arabic', 'Simplified Arabic', Arial, sans-serif;
            font-size: 11px;
            line-height: 1.4;
        }
        .header {
            text-align: center;
            border-bottom: 3px double #000;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .header h1 {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .header h2 {
            font-size: 14px;
            margin-bottom: 5px;
        }
        .header p {
            font-size: 12px;
            margin: 0;
        }
        table {
            font-size: 9px;
            width: 100%;
        }
        table th, table td {
            padding: 3px 5px !important;
            vertical-align: middle !important;
        }
        table thead th {
            background-color: #333 !important;
            color: white !important;
            font-weight: bold;
            text-align: center;
        }
        table tbody td {
            border: 1px solid #999;
        }
        table tfoot th {
            background-color: #ddd;
        }
        .stats-table {
            width: auto;
            margin: 0 auto 20px;
        }
        .stats-table td {
            padding: 5px 15px !important;
            text-align: center;
        }
        .footer {
            margin-top: 30px;
            border-top: 1px solid #999;
            padding-top: 15px;
        }
        .signature-section {
            margin-top: 40px;
        }
        .signature-box {
            display: inline-block;
            width: 24%;
            text-align: center;
            vertical-align: top;
        }
        .signature-line {
            border-bottom: 1px solid #000;
            margin: 30px auto 5px;
            width: 80%;
        }
        .form-number {
            position: absolute;
            top: 10px;
            left: 10px;
            font-size: 14px;
            font-weight: bold;
        }
        @@media print {
            body { margin: 0; padding: 10px; }
            .no-print { display: none !important; }
            @@page { 
                size: A4 landscape; 
                margin: 8mm;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid position-relative">
        <div class="form-number">نموذج رقم (5)</div>
        
        <!-- رأس التقرير -->
        <div class="header">
            <h1>جمهورية العراق</h1>
            <h2>@Model.Department</h2>
            <h1 class="mt-3">قائمة بالموجودات المستهلكة</h1>
            <p>العائدة لدائرة / @Model.Department</p>
            <p>بتاريخ @Model.ReportDate.ToString("yyyy/MM/dd")</p>
        </div>

        <!-- إحصائيات مختصرة -->
        <table class="table table-bordered stats-table">
            <tr>
                <td><strong>إجمالي العناصر:</strong> @Model.Statistics.TotalItems</td>
                <td><strong>إجمالي الكمية:</strong> @Model.Statistics.TotalQuantity</td>
                <td><strong>القيمة الأصلية:</strong> @Model.Statistics.TotalOriginalValue.ToString("N0") دينار</td>
                <td><strong>القيمة المتبقية:</strong> @Model.Statistics.TotalResidualValue.ToString("N0") دينار</td>
                <td><strong>الخسارة:</strong> @Model.Statistics.TotalLoss.ToString("N0") دينار</td>
            </tr>
        </table>

        <!-- جدول البيانات -->
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th rowspan="2" style="width: 25px;">ت</th>
                    <th rowspan="2" style="width: 120px;">مفردات المواد</th>
                    <th rowspan="2" style="width: 35px;">الكمية</th>
                    <th rowspan="2" style="width: 45px;">تاريخ الشراء</th>
                    <th colspan="2">سعر المفرد عند الشراء</th>
                    <th colspan="2">الثمن الكلي عند الشراء</th>
                    <th rowspan="2" style="width: 40px;">نسبة الضرر %</th>
                    <th rowspan="2" style="width: 50px;">مدة الاستعمال</th>
                    <th rowspan="2" style="width: 100px;">أسباب استهلاك المواد</th>
                    <th rowspan="2" style="width: 100px;">توجيهات اللجنة</th>
                </tr>
                <tr>
                    <th style="width: 50px;">دينار</th>
                    <th style="width: 30px;">فلس</th>
                    <th style="width: 60px;">دينار</th>
                    <th style="width: 30px;">فلس</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center">@item.SequenceNumber</td>
                        <td>@item.MaterialItems</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-center">@item.PurchaseYear</td>
                        <td class="text-end">@item.OriginalUnitPriceDinar.ToString("N0")</td>
                        <td class="text-center">@item.OriginalUnitPriceFils</td>
                        <td class="text-end">@item.OriginalTotalPriceDinar.ToString("N0")</td>
                        <td class="text-center">@item.OriginalTotalPriceFils</td>
                        <td class="text-center">@(item.DamagePercentage?.ToString() ?? "-")</td>
                        <td>@(item.UsageDuration ?? "-")</td>
                        <td><small>@item.ConsumptionReason.GetDisplayName()</small></td>
                        <td><small>@item.CommitteeDecision.GetDisplayName()</small></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="2" class="text-end">المجموع:</th>
                    <th class="text-center">@Model.Statistics.TotalQuantity</th>
                    <th colspan="3"></th>
                    <th class="text-end">@Model.Statistics.TotalOriginalValue.ToString("N0")</th>
                    <th colspan="5"></th>
                </tr>
            </tfoot>
        </table>

        <!-- ملاحظة -->
        <div class="mt-3 p-2 border">
            <p class="mb-1"><strong>ملاحظة:</strong></p>
            <p class="mb-0" style="font-size: 10px;">
                أسباب استهلاك المواد: وهل كان من جراء الاستعمال الاعتيادي أو من تقصير توصيات المسؤولين
            </p>
            <p class="mb-0" style="font-size: 10px;">
                توجيهات اللجنة: بإعادة استعمالها بعض أو كلا أو بيعها أو إتلافها
            </p>
        </div>

        <!-- قسم التواقيع -->
        <div class="signature-section">
            <div class="signature-box">
                <p><strong>رئيس اللجنة:</strong></p>
                <div class="signature-line"></div>
                <p>الاسم والتوقيع</p>
            </div>
            <div class="signature-box">
                <p><strong>عضو اللجنة:</strong></p>
                <div class="signature-line"></div>
                <p>الاسم والتوقيع</p>
            </div>
            <div class="signature-box">
                <p><strong>عضو اللجنة:</strong></p>
                <div class="signature-line"></div>
                <p>الاسم والتوقيع</p>
            </div>
            <div class="signature-box">
                <p><strong>المصادقة:</strong></p>
                <div class="signature-line"></div>
                <p>الاسم والتوقيع</p>
            </div>
        </div>

        <!-- تذييل -->
        <div class="footer text-center">
            <small>تم إنشاء هذا التقرير بواسطة نظام إدارة المخازن - @DateTime.Now.ToString("yyyy/MM/dd HH:mm")</small>
        </div>
    </div>

    <script>
        window.onload = function() {
            window.print();
        };
    </script>
</body>
</html>
