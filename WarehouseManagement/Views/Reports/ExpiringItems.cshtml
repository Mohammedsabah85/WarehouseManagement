@model IEnumerable<WarehouseManagement.Models.Material>

@{
    ViewData["Title"] = "المواد منتهية الصلاحية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>المواد منتهية الصلاحية</h2>
    <div>
        <form method="get" class="d-inline">
            <div class="input-group">
                <input type="number" name="days" value="@ViewBag.Days" class="form-control" placeholder="عدد الأيام" min="1">
                <button type="submit" class="btn btn-outline-primary">تحديث</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="alert alert-danger">
        <h5>🚨 تحذير انتهاء الصلاحية</h5>
        <p>يوجد @Model.Count() مادة تنتهي صلاحيتها خلال @ViewBag.Days يوم</p>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-danger">
                        <tr>
                            <th>الرمز</th>
                            <th>اسم المادة</th>
                            <th>الفئة</th>
                            <th>الموقع</th>
                            <th>تاريخ انتهاء الصلاحية</th>
                            <th>الأيام المتبقية</th>
                            <th>حالة الصلاحية</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var daysRemaining = item.ExpiryDate.HasValue ? (item.ExpiryDate.Value - DateTime.Now).Days : 0;
                            <tr class="@(daysRemaining <= 0 ? "table-danger" : daysRemaining <= 7 ? "table-warning" : "")">
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@item.Category.Name</td>
                                <td>@item.Location.Name</td>
                                <td>@item.ExpiryDate?.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <strong>@daysRemaining</strong>
                                    @if (daysRemaining <= 0)
                                    {
                                        <span class="badge bg-danger">منتهية</span>
                                    }
                                    else if (daysRemaining <= 7)
                                    {
                                        <span class="badge bg-warning">عاجل</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">قريباً</span>
                                    }
                                </td>
                                <td>
                                    @if (daysRemaining <= 0)
                                    {
                                        <span class="text-danger">منتهية الصلاحية</span>
                                    }
                                    else if (daysRemaining <= 7)
                                    {
                                        <span class="text-warning">تنتهي قريباً</span>
                                    }
                                    else
                                    {
                                        <span class="text-info">مراقبة</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-controller="Materials" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">عرض</a>
                                        @if (daysRemaining <= 0)
                                        {
                                            <button class="btn btn-sm btn-danger" onclick="alert('يجب التخلص من هذه المادة فوراً!')">منتهية</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-success">
        <h5>✅ ممتاز!</h5>
        <p>لا توجد مواد تنتهي صلاحيتها خلال @ViewBag.Days يوم القادمة</p>
    </div>
}
