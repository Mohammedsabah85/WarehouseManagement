@model IEnumerable<WarehouseManagement.Models.Material>

@{
    ViewData["Title"] = "المواد قليلة المخزون";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>المواد قليلة المخزون</h2>
    <div>
        <form method="get" class="d-inline">
            <div class="input-group">
                <input type="number" name="threshold" value="@ViewBag.Threshold" class="form-control" placeholder="حد الإنذار" min="1">
                <button type="submit" class="btn btn-outline-primary">تحديث</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="alert alert-warning">
        <h5>⚠️ تحذير</h5>
        <p>يوجد @Model.Count() مادة بكمية أقل من أو تساوي @ViewBag.Threshold وحدة</p>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-warning">
                        <tr>
                            <th>الرمز</th>
                            <th>اسم المادة</th>
                            <th>الفئة</th>
                            <th>الموقع</th>
                            <th>الكمية المتبقية</th>
                            <th>الوحدة</th>
                            <th>مستوى الخطر</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(m => m.Quantity))
                        {
                            <tr class="@(item.Quantity == 0 ? "table-danger" : item.Quantity <= 5 ? "table-warning" : "")">
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@item.Category.Name</td>
                                <td>@item.Location.Name</td>
                                <td>
                                    <strong>@item.Quantity</strong>
                                    @if (item.Quantity == 0)
                                    {
                                        <span class="badge bg-danger">نفدت</span>
                                    }
                                    else if (item.Quantity <= 5)
                                    {
                                        <span class="badge bg-warning">خطر</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">قليل</span>
                                    }
                                </td>
                                <td>@item.Unit</td>
                                <td>
                                    @if (item.Quantity == 0)
                                    {
                                        <span class="text-danger">عالي جداً</span>
                                    }
                                    else if (item.Quantity <= 5)
                                    {
                                        <span class="text-warning">عالي</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning">متوسط</span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Materials" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">تحديث الكمية</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-success">
        <h5>✅ ممتاز!</h5>
        <p>جميع المواد متوفرة بكميات كافية (أكثر من @ViewBag.Threshold وحدة)</p>
    </div>
}
